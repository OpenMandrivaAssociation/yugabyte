diff -ruN a/src/yb/rocksdb/util/compression.h b/src/yb/rocksdb/util/compression.h
--- a/src/yb/rocksdb/util/compression.h	2026-11-07 02:23:36.293459993 +0100
+++ b/src/yb/rocksdb/util/compression.h	2026-11-07 02:23:36.348867527 +0100
@@ -521,9 +521,10 @@
 
   int compressBound = LZ4_compressBound(static_cast<int>(length));
   output->resize(static_cast<size_t>(output_header_len + compressBound));
+  // lz4 1.11 removed LZ4_compress_limitedOutput(). Same arguments.
   int outlen =
-      LZ4_compress_limitedOutput(input, &(*output)[output_header_len],
-                                 static_cast<int>(length), compressBound);
+      LZ4_compress_default(input, &(*output)[output_header_len],
