   if (outlen == 0) {
     return false;
   }
@@ -603,9 +604,10 @@
   output->resize(static_cast<size_t>(output_header_len + compressBound));
   int outlen;
 #ifdef LZ4_VERSION_MAJOR  // they only started defining this since r113
-  outlen = LZ4_compressHC2_limitedOutput(input, &(*output)[output_header_len],
