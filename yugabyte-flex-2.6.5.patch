flex 2.7 declares yypanic() and, in a C scanner, nothing else calls it when
YY_FATAL_ERROR is overridden. AGE's macro has to call it or -Werror
rejects the unused static function. A C++ scanner uses LexerError().

--- a/src/postgres/third-party-extensions/mage/src/backend/parser/ag_scanner.l
+++ b/src/postgres/third-party-extensions/mage/src/backend/parser/ag_scanner.l
@@ -301,13 +301,14 @@
 
 /*
  * Avoid exit() on fatal scanner errors.
- * Call yy_fatal_error() just to keep compiler quiet.
+ * flex 2.7 names the handler yypanic(). ereport(ERROR) does not return;
+ * the call keeps that static function referenced under -Werror.
  */
 #define YY_FATAL_ERROR(msg) \
     do \
     { \
         ereport(ERROR, (errmsg_internal("%s", msg))); \
-        yy_fatal_error(NULL, NULL); \
+        yypanic(msg, yyscanner); \
     } while (0)
 
