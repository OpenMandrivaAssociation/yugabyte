-      (started_hiding_or_deleting ? LOG(WARNING) : LOG(DFATAL))
-          << "Error updating table " << table_->ToString() << ": " << s;
+      // Abseil's LOG() is a statement, so it cannot be a ternary operand.
+      if (started_hiding_or_deleting) {
